COMPOSE_PROJECT_NAME=colla-s05-capacity
CAPACITY_RUNNER_IMAGE=colla-s05-capacity-capacity-runner
POSTGRES_DB=colla_platform
POSTGRES_USER=colla
POSTGRES_PASSWORD=replace-with-disposable-capacity-password

MINIO_ACCESS_KEY=capacity-minio
MINIO_SECRET_KEY=replace-with-disposable-capacity-minio-secret
MINIO_BUCKET=colla-files

JWT_ACCESS_SECRET=replace-with-64-byte-capacity-access-secret
JWT_REFRESH_SECRET=replace-with-64-byte-capacity-refresh-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=1

INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=replace-with-disposable-capacity-admin-password
INIT_ADMIN_DISPLAY_NAME=Capacity Administrator
INIT_ADMIN_EMAIL=capacity-admin@colla.local

CORS_ALLOWED_ORIGINS=http://127.0.0.1:18088
MAX_UPLOAD_SIZE_BYTES=104857600
APP_BASE_URL=http://127.0.0.1:18088
COLLA_COLLABORATION_INTERNAL_SECRET=replace-with-disposable-capacity-collaboration-secret
COLLA_CAPACITY_PROBE_SECRET=replace-with-disposable-capacity-probe-secret
SOURCE_COMMIT=replace-with-exact-git-commit

SERVER_IMAGE=colla-platform-server:capacity
WEB_IMAGE=colla-platform-web:capacity
COLLABORATION_IMAGE=colla-platform-collaboration:capacity
HTTP_PORT=18088
HTTPS_PORT=18443
API_A_METRICS_PORT=19081
API_B_METRICS_PORT=19082
WORKER_A_METRICS_PORT=19083
WORKER_B_METRICS_PORT=19084
GATEWAY_A_METRICS_PORT=19085
GATEWAY_B_METRICS_PORT=19086
COLLABORATION_A_METRICS_PORT=19101
COLLABORATION_B_METRICS_PORT=19102
# These URLs are for host inspection. stack.mjs maps the capacity-runner to the
# equivalent Compose service DNS names instead of passing host loopback URLs.
COLLA_CAPACITY_API_A_METRICS_URL=http://127.0.0.1:19081/actuator/prometheus
COLLA_CAPACITY_API_B_METRICS_URL=http://127.0.0.1:19082/actuator/prometheus
COLLA_CAPACITY_WORKER_A_METRICS_URL=http://127.0.0.1:19083/actuator/prometheus
COLLA_CAPACITY_WORKER_B_METRICS_URL=http://127.0.0.1:19084/actuator/prometheus
COLLA_CAPACITY_GATEWAY_A_METRICS_URL=http://127.0.0.1:19085/actuator/prometheus
COLLA_CAPACITY_GATEWAY_B_METRICS_URL=http://127.0.0.1:19086/actuator/prometheus
COLLA_CAPACITY_COLLABORATION_A_METRICS_URL=http://127.0.0.1:19101/metrics
COLLA_CAPACITY_COLLABORATION_B_METRICS_URL=http://127.0.0.1:19102/metrics

# Frozen C1 candidate topology. The validation command rejects totals above the
# declared dependency budgets before the stack is started.
COLLA_POSTGRESQL_CONNECTION_BUDGET=100
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_CPU_LIMIT=3.0
POSTGRES_MEMORY_LIMIT=6G
REDIS_MAX_CLIENTS=128
REDIS_MAX_MEMORY=1536mb
REDIS_CPU_LIMIT=1.5
REDIS_MEMORY_LIMIT=2G
MINIO_CPU_LIMIT=1.5
MINIO_MEMORY_LIMIT=3G

API_DB_POOL_SIZE=12
API_DB_MIN_IDLE=2
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=2560M
API_JAVA_TOOL_OPTIONS=-Xms768m -Xmx1792m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

WORKER_DB_POOL_SIZE=6
WORKER_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=1024M
WORKER_JAVA_TOOL_OPTIONS=-Xms256m -Xmx704m -XX:+UseG1GC -XX:MaxGCPauseMillis=250 -Dcolla.worker.concurrency=4
COLLA_EVENT_WORKER_EXPECTED_INSTANCES=2
COLLA_EVENT_WORKER_CLAIM_BATCH=20
COLLA_EVENT_WORKER_CONCURRENCY=4
COLLA_EVENT_WORKER_QUEUE_CAPACITY=16

GATEWAY_DB_POOL_SIZE=4
GATEWAY_MAX_CONNECTIONS=5000
GATEWAY_CPU_LIMIT=1.0
GATEWAY_MEMORY_LIMIT=1024M
GATEWAY_JAVA_TOOL_OPTIONS=-Xms256m -Xmx704m -XX:+UseG1GC -Dcolla.realtime.max-connections=5000

COLLABORATION_MAX_CONNECTIONS=5000
COLLABORATION_MAX_ROOMS=1000
COLLABORATION_MAX_PENDING_UPDATES=1024
COLLABORATION_MAX_PENDING_BYTES=33554432
COLLABORATION_CPU_LIMIT=1.0
COLLABORATION_MEMORY_LIMIT=1024M
COLLABORATION_NODE_OPTIONS=--max-old-space-size=704 --enable-source-maps --unhandled-rejections=strict

MAINTENANCE_DB_POOL_SIZE=4
MAINTENANCE_CPU_LIMIT=0.5
MAINTENANCE_MEMORY_LIMIT=768M
MAINTENANCE_JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:+UseG1GC -Djava.security.egd=file:/dev/urandom
WEB_CPU_LIMIT=0.5
WEB_MEMORY_LIMIT=512M
NGINX_CPU_LIMIT=0.5
NGINX_MEMORY_LIMIT=512M
CAPACITY_CPU_LIMIT=2.5
CAPACITY_MEMORY_LIMIT=4G
CAPACITY_NODE_OPTIONS=--max-old-space-size=2048 --enable-source-maps --unhandled-rejections=strict

# Logical host location. stack.mjs exports the absolute repository-root path to
# Compose so /evidence in capacity-runner always maps to this directory.
CAPACITY_EVIDENCE_DIR=.local-reports/capacity
CAPACITY_PROBE_MAX_EVENTS_PER_RUN=100000
CAPACITY_PROBE_MAX_PAGE_SIZE=1000
CAPACITY_ACCESS_TOKEN_TTL_MINUTES=720
CAPACITY_COLLABORATION_TICKET_TTL=12h
