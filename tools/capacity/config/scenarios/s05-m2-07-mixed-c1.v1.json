{
  "schemaVersion": "colla.capacity-scenario/v1",
  "id": "s05-m2-07-mixed-c1",
  "revision": 1,
  "description": "Frozen concurrent C1 mixed-load contract for PLATFORM-SCALE-S05-M2-T07.",
  "evidence": { "requireProvenance": true },
  "contract": {
    "milestoneTask": "PLATFORM-SCALE-S05-M2-T07",
    "c1ContractId": "C1",
    "targets": {
      "httpRps": 150,
      "httpReadWeight": 0.8,
      "httpWriteWeight": 0.2,
      "workerSustainedEventsPerSecond": 30,
      "ordinaryWebSockets": 1000,
      "yjsClients": 100,
      "yjsRooms": 25
    },
    "requiredAssertions": [
      "all-four-loaders-reach-target-concurrently",
      "shared-dependency-contention-captured",
      "workspace-and-permission-isolation",
      "idempotency-and-ordering-preserved",
      "single-domain-pass-cannot-override-mixed-failure"
    ],
    "acceptance": [
      { "id": "http-read-p95", "metric": "http.read.latency.p95_ms", "operator": "lte", "value": 300, "unit": "ms" },
      { "id": "http-write-p95", "metric": "http.write.latency.p95_ms", "operator": "lte", "value": 500, "unit": "ms" },
      { "id": "unexpected-5xx-rate", "metric": "http.unexpected_5xx.rate", "operator": "lt", "value": 0.005, "unit": "ratio" },
      { "id": "event-fanout-p95", "metric": "websocket.fanout.latency.p95_ms", "operator": "lte", "value": 1000, "unit": "ms" },
      { "id": "websocket-reconcile", "metric": "websocket.reconnect_reconcile.max_ms", "operator": "lte", "value": 10000, "unit": "ms" },
      { "id": "collaboration-convergence-p95", "metric": "yjs.cross_node_convergence.latency.p95_ms", "operator": "lte", "value": 1000, "unit": "ms" },
      { "id": "outbox-oldest-age-p95", "metric": "worker.outbox_oldest_age.p95_ms", "operator": "lte", "value": 5000, "unit": "ms" },
      { "id": "dead-letter-count", "metric": "worker.dead_letter.count", "operator": "eq", "value": 0, "unit": "count" }
    ],
    "conclusionPolicy": {
      "allowed": ["Pass", "Fail", "Bounded", "Not-Committed"],
      "aborted": "Fail",
      "incompleteEvidence": "Not-Committed",
      "targetMiss": "Fail",
      "lowerEnvelope": "Bounded"
    }
  },
  "execution": {
    "mode": "concurrent",
    "warmup": { "enabled": true, "required": true, "mode": "concurrent", "durationMs": 300000 },
    "durationMs": 900000,
    "abort": {
      "maxDurationMs": 1440000,
      "stopOnLoaderFailure": true,
      "maxErrorCount": 674,
      "maxErrorRate": 0.004999,
      "maxCollectorFailures": 0
    }
  },
  "loaders": {
    "http": {
      "enabled": true,
      "options": {
        "targetRps": 150,
        "concurrency": 200,
        "phaseWeights": { "read": 0.8, "write": 0.2 }
      },
      "warmupOptions": {
        "targetRps": 30,
        "concurrency": 50,
        "phaseWeights": { "read": 0.8, "write": 0.2 }
      }
    },
    "websocket": {
      "enabled": true,
      "options": {
        "connections": 1000,
        "connectConcurrency": 100,
        "connectTimeoutMs": 10000,
        "reconnects": 1,
        "reconnectSettleMs": 1000,
        "requireReady": true
      },
      "warmupOptions": {
        "connections": 100,
        "connectConcurrency": 25,
        "reconnects": 0
      }
    },
    "collaboration": {
      "enabled": true,
      "options": {
        "clientsPerRoom": 4,
        "editsPerClient": 10,
        "reconnectsPerRoom": 1,
        "syncTimeoutMs": 10000,
        "convergenceTimeoutMs": 1000,
        "pollIntervalMs": 20
      },
      "warmupOptions": {
        "clientsPerRoom": 2,
        "editsPerClient": 1,
        "reconnectsPerRoom": 0
      }
    },
    "worker": {
      "enabled": true,
      "options": {
        "rateMode": "sustained",
        "sustainedEventsPerSecond": 30,
        "concurrency": 40,
        "maxBacklog": 0,
        "maxOldestAgeSeconds": 5,
        "maxRetryIncrease": 0,
        "maxDeadLetterIncrease": 0,
        "drainTimeoutMs": 300000
      },
      "warmupOptions": {
        "sustainedEventsPerSecond": 10,
        "concurrency": 20
      }
    }
  },
  "metrics": {
    "intervalMs": 5000,
    "prometheus": [
      {
        "id": "api-a",
        "endpointEnv": "COLLA_CAPACITY_API_A_METRICS_URL",
        "required": true,
        "metricNames": ["http_server_requests_seconds_count", "http_server_requests_seconds_sum", "hikaricp_connections_active", "hikaricp_connections_pending", "jvm_gc_pause_seconds_count", "jvm_memory_used_bytes", "process_cpu_usage"],
        "labelAllowlist": ["runtime_role", "instance_id", "method", "status"]
      },
      {
        "id": "api-b",
        "endpointEnv": "COLLA_CAPACITY_API_B_METRICS_URL",
        "required": true,
        "metricNames": ["http_server_requests_seconds_count", "http_server_requests_seconds_sum", "hikaricp_connections_active", "hikaricp_connections_pending", "jvm_gc_pause_seconds_count", "jvm_memory_used_bytes", "process_cpu_usage"],
        "labelAllowlist": ["runtime_role", "instance_id", "method", "status"]
      },
      {
        "id": "worker-a",
        "endpointEnv": "COLLA_CAPACITY_WORKER_A_METRICS_URL",
        "required": true,
        "metricNames": ["colla_event_delivery_pending", "colla_event_delivery_oldest_age_seconds", "colla_event_delivery_dead_letter", "jvm_memory_used_bytes", "process_cpu_usage"],
        "labelAllowlist": ["runtime_role", "instance_id"]
      },
      {
        "id": "worker-b",
        "endpointEnv": "COLLA_CAPACITY_WORKER_B_METRICS_URL",
        "required": true,
        "metricNames": ["colla_event_delivery_pending", "colla_event_delivery_oldest_age_seconds", "colla_event_delivery_dead_letter", "jvm_memory_used_bytes", "process_cpu_usage"],
        "labelAllowlist": ["runtime_role", "instance_id"]
      },
      {
        "id": "gateway-a",
        "endpointEnv": "COLLA_CAPACITY_GATEWAY_A_METRICS_URL",
        "required": true,
        "metricNames": ["colla_realtime_websocket_connections", "colla_realtime_websocket_session_queues", "colla_realtime_redis_consume_total", "jvm_memory_used_bytes", "process_cpu_usage"],
        "labelAllowlist": ["runtime_role", "instance_id", "outcome"]
      },
      {
        "id": "gateway-b",
        "endpointEnv": "COLLA_CAPACITY_GATEWAY_B_METRICS_URL",
        "required": true,
        "metricNames": ["colla_realtime_websocket_connections", "colla_realtime_websocket_session_queues", "colla_realtime_redis_consume_total", "jvm_memory_used_bytes", "process_cpu_usage"],
        "labelAllowlist": ["runtime_role", "instance_id", "outcome"]
      }
    ],
    "json": [
      {
        "id": "collaboration-a",
        "endpointEnv": "COLLA_CAPACITY_COLLABORATION_A_METRICS_URL",
        "required": true,
        "headerEnv": { "x-colla-collaboration-secret": "COLLA_COLLABORATION_INTERNAL_SECRET" },
        "metricNames": ["connections", "documents", "reservedConnections", "durableQueue.updates", "durableQueue.bytes", "durableQueue.retryAttempts", "durableQueue.backpressureRejections", "failures.backend", "failures.redis", "failures.recovery", "failures.store"]
      },
      {
        "id": "collaboration-b",
        "endpointEnv": "COLLA_CAPACITY_COLLABORATION_B_METRICS_URL",
        "required": true,
        "headerEnv": { "x-colla-collaboration-secret": "COLLA_COLLABORATION_INTERNAL_SECRET" },
        "metricNames": ["connections", "documents", "reservedConnections", "durableQueue.updates", "durableQueue.bytes", "durableQueue.retryAttempts", "durableQueue.backpressureRejections", "failures.backend", "failures.redis", "failures.recovery", "failures.store"]
      }
    ],
    "docker": {
      "id": "capacity-stack",
      "enabled": true,
      "required": true,
      "containers": [
        "colla-s05-capacity-postgres-1",
        "colla-s05-capacity-redis-1",
        "colla-s05-capacity-minio-1",
        "colla-s05-capacity-api-a-1",
        "colla-s05-capacity-api-b-1",
        "colla-s05-capacity-worker-a-1",
        "colla-s05-capacity-worker-b-1",
        "colla-s05-capacity-event-gateway-a-1",
        "colla-s05-capacity-event-gateway-b-1",
        "colla-s05-capacity-collaboration-a-1",
        "colla-s05-capacity-collaboration-b-1",
        "colla-s05-capacity-web-1",
        "colla-s05-capacity-nginx-1"
      ]
    }
  },
  "thresholds": {
    "maxErrorRate": 0.004999,
    "minSamples": 137100,
    "loaders": {
      "http": { "required": true, "maxErrorRate": 0.004999, "minSamples": 135000 },
      "websocket": { "required": true, "maxErrorRate": 0, "maxP95Ms": 1000, "minSamples": 1000 },
      "collaboration": { "required": true, "maxErrorRate": 0, "maxP95Ms": 1000, "minSamples": 100 },
      "worker": { "required": true, "maxErrorRate": 0, "minSamples": 27000 }
    },
    "metrics": [
      { "id": "worker-a-oldest-age", "source": "worker-a", "metric": "colla_event_delivery_oldest_age_seconds", "aggregate": "max", "operator": "<=", "value": 5 },
      { "id": "worker-b-oldest-age", "source": "worker-b", "metric": "colla_event_delivery_oldest_age_seconds", "aggregate": "max", "operator": "<=", "value": 5 },
      { "id": "worker-a-dead-letter", "source": "worker-a", "metric": "colla_event_delivery_dead_letter", "aggregate": "max", "operator": "==", "value": 0 },
      { "id": "worker-b-dead-letter", "source": "worker-b", "metric": "colla_event_delivery_dead_letter", "aggregate": "max", "operator": "==", "value": 0 }
    ]
  }
}
